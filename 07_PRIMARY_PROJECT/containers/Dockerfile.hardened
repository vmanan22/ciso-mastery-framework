# ==============================================================================
# Hardened Multi-Stage Dockerfile (Zero-CVE & Minimal Attack Surface)
# Target: Minimal Non-Root Hardened Runtime
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Pure Dependency Isolation
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev && \
    rm -rf /var/lib/apt/lists/*

COPY app/requirements.txt .
# Install pure runtime dependencies into /opt/packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --target=/opt/packages -r requirements.txt

COPY app/ .

# ------------------------------------------------------------------------------
# Stage 2: Hardened Non-Root Production Runtime
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS runner

WORKDIR /app

# Apply latest Debian security updates and remove base image build packaging tools
RUN apt-get update && \
    apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /usr/local/lib/python3.11/site-packages/pip* \
           /usr/local/lib/python3.11/site-packages/setuptools* \
           /usr/local/lib/python3.11/site-packages/wheel* \
           /usr/local/lib/python3.11/site-packages/jaraco* \
           /usr/local/lib/python3.11/site-packages/_distutils_hack*

# Create non-root unprivileged user (UID 65532)
RUN groupadd -g 65532 nonroot && \
    useradd -u 65532 -g 65532 -m -s /sbin/nologin nonroot

# Copy pure runtime dependencies and application
COPY --from=builder --chown=65532:65532 /opt/packages /opt/packages
COPY --from=builder --chown=65532:65532 /app /app

ENV PATH="/opt/packages/bin:$PATH" \
    PYTHONPATH="/opt/packages"

# Enforce Non-Root Execution (UID 65532: nonroot)
USER nonroot:nonroot

EXPOSE 8080

# Health check using python urllib
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')"]

ENTRYPOINT ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
